# Database — SQLite for local development and tests.
# For PostgreSQL (production): set provider = "postgresql" in prisma/schema.prisma
# and point DATABASE_URL at your Postgres instance. See DATABASE.md.
DATABASE_URL="file:./dev.db"

# Session signing secret — generate a long random value per environment.
# e.g. openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Set to "1" ONLY when the app runs behind a trusted reverse proxy that sets
# and overwrites x-forwarded-for. Off by default so spoofed headers cannot
# bypass the login/enquiry rate limits.
TRUST_PROXY="0"

# Google Apps Script Web App that writes website enquiries to Google Sheets.
# Server-side only (used by the /api/enquiries proxy) so it is never bundled
# into client JavaScript. The deployment MUST be shared as "Anyone".
# If unset, the script ships with Vela's default deployment id.
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycbygYbefsHtNZhq3fL4EMs3SGpsWhazdgvWs394mt1FTds7Ylhajv_4F5O27nflOdzOOVg/exec"

# Seeded admin credentials (dev only — override in production)
SEED_ADMIN_EMAIL="admin@velabysvasti.local"
SEED_ADMIN_PASSWORD="ChangeMe@Vela123"
